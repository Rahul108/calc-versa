# Docker Compose variables for infra/docker/docker-compose.yml.
# Copy to infra/docker/.env (gitignored) and fill in.

# JWT signing secret for the API Gateway. Must be at least 32 characters.
# Generate one with: openssl rand -hex 48
JWT_SECRET=

# Comma-separated browser origins allowed by CORS (no wildcard).
CORS_ORIGINS=http://localhost:4200

# Browser-facing API URLs baked into the frontend build.
VITE_API_GATEWAY_URL=http://localhost:3005
VITE_AI_ASSISTANT_URL=http://localhost:3006
