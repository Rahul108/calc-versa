{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "vite/client"
    ],
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
